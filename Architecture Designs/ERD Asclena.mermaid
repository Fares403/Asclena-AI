erDiagram

    %% =========================================================
    %% AUTH & STAFF DOMAIN
    %% =========================================================

    User {
        bigint      user_id                  PK
        varchar     first_name
        varchar     last_name
        varchar     email                    UK
        varchar     password
        varchar     phone
        boolean     is_active
        datetime    created_at
        datetime    updated_at
    }

    Role {
        bigint      role_id                  PK
        varchar     role_name
    }

    UserRole {
        bigint      user_id                  PK,FK
        bigint      role_id                  PK,FK
        datetime    assigned_at
    }

    Permission {
        bigint      permission_id            PK
        varchar     code
    }

    RolePermission {
        bigint      role_id                  PK,FK
        bigint      permission_id            PK,FK
    }

    Screen {
        bigint      screen_id                PK
        varchar     code
        varchar     path
        varchar     module
        bigint      required_permission_id   FK
        boolean     is_active
    }

    AuditLog {
        bigint      audit_log_id             PK
        bigint      user_id                  FK
        varchar     action
        varchar     entity_type
        bigint      entity_id
        datetime    created_at
    }

    Doctor {
        bigint      doctor_id                PK,FK
        varchar     specialty
        varchar     license_number
    }

    LabStaff {
        bigint      lab_staff_id             PK,FK
        varchar     lab_department
    }

    RadiologyStaff {
        bigint      radiology_staff_id       PK,FK
        varchar     imaging_department
    }

    Receptionist {
        bigint      receptionist_id          PK,FK
    }

    %% =========================================================
    %% CORE PATIENT / CASE / EPISODE DOMAIN
    %% case = patient file; every ED visit => new episode
    %% =========================================================

    Patient {
        bigint      patient_id               PK "alias: subject_id"
        varchar     mrn                      UK
        varchar     first_name
        varchar     last_name
        varchar     national_id
        date        dob
        varchar     gender
        varchar     race
        varchar     phone
        varchar     email
        varchar     address
        varchar     blood_type
        datetime    created_at
        datetime    updated_at
    }

    CaseRecord {
        bigint      case_id                  PK
        bigint      patient_id               FK,UK
        boolean     is_active
        decimal     risk_score
        varchar     risk_level
        text        summary
        datetime    created_at
        datetime    updated_at
    }

    Episode {
        bigint      episode_id               PK "alias: stay_id"
        bigint      case_id                  FK
        bigint      hadm_id                  "nullable"
        datetime    intime
        datetime    outtime
        varchar     arrival_transport
        varchar     disposition
        varchar     status
        datetime    created_at
        datetime    updated_at
    }

    EpisodeClinicalNote {
        bigint      note_id                  PK
        bigint      episode_id               FK
        varchar     note_type
        text        content
        bigint      created_by               FK
        datetime    created_at
    }

    %% =========================================================
    %% CLINICAL FEATURES DOMAIN (aligned with model samples)
    %% =========================================================

    Triage {
        bigint      triage_id                PK
        bigint      episode_id               FK,UK
        decimal     temperature
        integer     heartrate
        integer     resprate
        integer     o2sat
        integer     sbp
        integer     dbp
        integer     pain_score
        varchar     pain_status
        integer     acuity
        text        chiefcomplaint
        datetime    created_at
    }

    VitalSign {
        bigint      measurement_id           PK
        bigint      episode_id               FK
        datetime    charttime
        decimal     temperature
        integer     heartrate
        integer     resprate
        integer     o2sat
        integer     sbp
        integer     dbp
        varchar     rhythm
        integer     pain_score
        varchar     pain_status
        bigint      recorded_by              FK
    }

    Diagnosis {
        bigint      diagnosis_id             PK
        bigint      episode_id               FK
        integer     seq_num                  "ordered within episode"
        varchar     icd_code
        integer     icd_version
        varchar     icd_title
        datetime    created_at
    }

    Pyxis {
        bigint      pyxis_id                 PK
        bigint      episode_id               FK
        datetime    charttime
        integer     med_rn
        varchar     name
        integer     gsn_rn
        varchar     gsn
    }

    MedRecon {
        bigint      med_recon_id             PK
        bigint      episode_id               FK
        datetime    charttime                "snapshot_time"
        varchar     name
        varchar     gsn
        varchar     ndc
        integer     etc_rn
        varchar     etccode
        text        etcdescription
    }

    %% =========================================================
    %% OTHER CLINICAL DOMAIN TABLES
    %% =========================================================

    PatientInsurance {
        bigint      insurance_id             PK
        bigint      patient_id               FK
        varchar     company
        varchar     policy_number
        varchar     class
        date        expiry_date
        boolean     is_active
    }

    PatientEmergencyContact {
        bigint      contact_id               PK
        bigint      patient_id               FK
        varchar     name
        varchar     relationship
        varchar     phone
        boolean     is_primary
        datetime    created_at
    }

    PatientAllergy {
        bigint      allergy_id               PK
        bigint      patient_id               FK
        varchar     allergen
        varchar     severity
        varchar     reaction
        boolean     is_active
    }

    LabOrder {
        bigint      lab_order_id             PK
        bigint      episode_id               FK
        bigint      ordered_by               FK
        datetime    order_date
        varchar     status
        varchar     priority
    }

    LabResult {
        bigint      lab_result_id            PK
        bigint      lab_order_id             FK
        varchar     status
        bigint      reviewed_by              FK
        datetime    reviewed_at
    }

    LabResultItem {
        bigint      lab_result_item_id       PK
        bigint      lab_result_id            FK
        varchar     analyte_code
        varchar     value
        varchar     unit
        varchar     reference_range_text
        varchar     flag
    }

    ImagingOrder {
        bigint      imaging_order_id         PK
        bigint      episode_id               FK
        bigint      ordered_by               FK
        varchar     modality
        varchar     body_part
        varchar     status
        datetime    order_date
    }

    ImagingResult {
        bigint      imaging_result_id        PK
        bigint      imaging_order_id         FK
        text        findings
        text        conclusion
        text        report_text
        bigint      reviewed_by              FK
        datetime    reviewed_at
    }

    Medication {
        bigint      medication_id            PK
        varchar     name
    }

    Prescription {
        bigint      prescription_id          PK
        bigint      episode_id               FK
        bigint      medication_id            FK
        varchar     dose
        varchar     frequency
        varchar     duration
        varchar     status
        bigint      prescribed_by            FK
        datetime    start_date
        datetime    end_date
    }

    Appointment {
        bigint      appointment_id           PK
        bigint      patient_id               FK
        bigint      doctor_id                FK
        bigint      receptionist_id          FK
        datetime    scheduled_date_time
        varchar     status
        datetime    check_in_time
        datetime    start_time
        datetime    end_time
        datetime    created_at
    }

    %% =========================================================
    %% ANALYTICS / ML DOMAIN
    %% =========================================================

    RiskPrediction {
        bigint      risk_prediction_id       PK
        bigint      episode_id               FK "primary link (alias: stay_id)"
        bigint      patient_id               FK "optional history link (alias: subject_id)"
        varchar     model_name
        varchar     model_version
        decimal     risk_score
        integer     predicted_target
        varchar     risk_label
        integer     severity_index
        varchar     severity_label
        text        severity_description
        varchar     severity_scale_name
        decimal     threshold_used
        text        top_features
        datetime    created_at
    }

    PredictionFeatureImportance {
        bigint      importance_id            PK
        bigint      risk_prediction_id       FK
        varchar     feature_name
        decimal     feature_value
        decimal     impact_score
    }

    PredictionFeedback {
        bigint      feedback_id              PK
        bigint      risk_prediction_id       FK,UK
        bigint      doctor_id                FK
        boolean     is_clinically_accurate
        text        clinical_notes
        datetime    created_at
    }

    %% =========================================================
    %% RELATIONSHIPS
    %% =========================================================

    %% Auth
    User            ||--o{ UserRole                : "assigned to"
    Role            ||--o{ UserRole                : "contains users"
    Role            ||--o{ RolePermission          : "grants"
    Permission      ||--o{ RolePermission          : "included in"
    Permission      ||--o{ Screen                  : "required for"
    User            ||--o{ AuditLog                : "generates"

    %% Staff profiles
    User            ||--o| Doctor                  : "profile"
    User            ||--o| LabStaff                : "profile"
    User            ||--o| RadiologyStaff          : "profile"
    User            ||--o| Receptionist            : "profile"

    %% Patient / case / episodes
    Patient         ||--|| CaseRecord              : "has one case file"
    CaseRecord      ||--o{ Episode                 : "contains episodes"
    Episode         ||--o{ EpisodeClinicalNote     : "has notes"
    User            ||--o{ EpisodeClinicalNote     : "created by"

    %% ED clinical data used by feature engineering
    Episode         ||--o| Triage                  : "initial triage"
    Episode         ||--o{ VitalSign               : "vitals over time"
    Episode         ||--o{ Diagnosis               : "diagnoses"
    Episode         ||--o{ Pyxis                   : "dispensed meds"
    Episode         ||--o{ MedRecon                : "med reconciliation snapshots"
    User            ||--o{ VitalSign               : "recorded by"

    %% Other clinical domains
    Patient         ||--o{ PatientInsurance        : "has"
    Patient         ||--o{ PatientEmergencyContact : "has"
    Patient         ||--o{ PatientAllergy          : "has"
    Patient         ||--o{ Appointment             : "books"
    Doctor          ||--o{ Appointment             : "sees"
    Receptionist    ||--o{ Appointment             : "manages"

    Episode         ||--o{ LabOrder                : "orders"
    Doctor          ||--o{ LabOrder                : "ordered by"
    LabOrder        ||--o| LabResult               : "produces"
    LabResult       ||--o{ LabResultItem           : "contains"
    LabStaff        ||--o{ LabResult               : "reviews"

    Episode         ||--o{ ImagingOrder            : "orders"
    Doctor          ||--o{ ImagingOrder            : "ordered by"
    ImagingOrder    ||--o| ImagingResult           : "produces"
    RadiologyStaff  ||--o{ ImagingResult           : "reviews"

    Episode         ||--o{ Prescription            : "includes"
    Medication      ||--o{ Prescription            : "used in"
    Doctor          ||--o{ Prescription            : "prescribes"

    %% ML output persistence
    Episode         ||--o{ RiskPrediction          : "predicted for stay"
    Patient         ||--o{ RiskPrediction          : "optional patient history"
    RiskPrediction  ||--o{ PredictionFeatureImportance : "explained by"
    RiskPrediction  ||--o| PredictionFeedback      : "reviewed by"
    Doctor          ||--o{ PredictionFeedback      : "provides"

    %% NOTE:
    %% - features are extracted dynamically during inference from raw tables:
    %%   Triage, VitalSign, Diagnosis, Pyxis, and MedRecon
    %% - Episode (stay_id) is the anchor for ED clinical feature tables
    %% - Naming bridge for current ML pipeline:
    %%   episode_id <-> stay_id
    %%   patient_id <-> subject_id
    %% - During integration, keep a compatibility layer (view/alias) until
    %%   SQL + modeling code are fully migrated to episode_id/patient_id names
    %% - Add DB index: VitalSign(episode_id, charttime) for time-series retrieval
    %% - Add DB unique constraint: Diagnosis(episode_id, seq_num) for ordered diagnoses
    %% - Add DB check constraints for pain_status allowed values
    %%   ('asleep','unable','uta','unknown')
    %% - Validate timeline in processing: charttime between Episode.intime and Episode.outtime
    %% - feature engineering is performed in application memory only
    %% - no persisted feature-store table in database

    %% =========================================================
    %% VISUAL STYLING (High-Tech Presentation)
    %% =========================================================

    %% Core domain (primary: Medical Blue / Navy)
%% =========================
%% CORE DOMAIN (Primary Blue - Soft)
%% =========================
style Patient fill:#E8F0FE,stroke:#3B82F6,color:#1E3A8A
style CaseRecord fill:#DBEAFE,stroke:#60A5FA,color:#1E3A8A
style Episode fill:#E0E7FF,stroke:#6366F1,color:#1E3A8A

%% =========================
%% CLINICAL DOMAIN (Teal - Clean Medical)
%% =========================
style Triage fill:#ECFEFF,stroke:#14B8A6,color:#0F766E
style VitalSign fill:#F0FDFA,stroke:#2DD4BF,color:#115E59
style Diagnosis fill:#ECFEFF,stroke:#14B8A6,color:#0F766E
style Pyxis fill:#F0FDFA,stroke:#2DD4BF,color:#115E59
style MedRecon fill:#ECFEFF,stroke:#14B8A6,color:#0F766E

%% =========================
%% AI / ML DOMAIN (Amber - Attention)
%% =========================
style RiskPrediction fill:#FFFBEB,stroke:#F59E0B,color:#92400E
style PredictionFeatureImportance fill:#FFFBEB,stroke:#F59E0B,color:#92400E
style PredictionFeedback fill:#FFFBEB,stroke:#F59E0B,color:#92400E